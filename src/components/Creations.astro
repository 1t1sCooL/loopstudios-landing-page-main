---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

// line breaks match the design mockup exactly
const creations = [
  { slug: 'deep-earth', lines: ['Deep', 'earth'] },
  { slug: 'night-arcade', lines: ['Night', 'arcade'] },
  { slug: 'soccer-team', lines: ['Soccer', 'team VR'] },
  { slug: 'grid', lines: ['The', 'grid'] },
  { slug: 'from-above', lines: ['From up', 'above VR'] },
  { slug: 'pocket-borealis', lines: ['Pocket', 'borealis'] },
  { slug: 'curiosity', lines: ['The', 'curiosity'] },
  { slug: 'fisheye', lines: ['Make it', 'fisheye'] },
];
---

<section class="creations container" aria-labelledby="creations-title">
  <div class="creations-head">
    <h2 id="creations-title">Our creations</h2>
    <a href="#" class="see-all" data-desktop>See all</a>
  </div>

  <ul class="grid">
    {creations.map(({ slug, lines }) => (
      <li>
        <a
          href="#"
          class="card"
          style={`--img-desktop: url(${base}images/desktop/image-${slug}.jpg); --img-mobile: url(${base}images/mobile/image-${slug}.jpg)`}
        >
          <span class="card-title">{lines[0]}<br />{lines[1]}</span>
        </a>
      </li>
    ))}
  </ul>

  <a href="#" class="see-all" data-mobile>See all</a>
</section>

<style>
  .creations {
    margin-block-start: 11.5rem;
    margin-block-end: 11.5625rem;
  }

  /* the mockup grid is 4x256px with ~29.3px gaps: 3px wider than the 1110px container */
  .creations-head,
  .grid {
    width: 69.5625rem;
    max-width: none;
  }

  .creations-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  h2 {
    font-size: 3rem;
    line-height: 3rem;
  }

  .see-all {
    display: inline-block;
    width: 9.875rem;
    height: 2.625rem;
    line-height: 2.5rem;
    text-align: center;
    border: 0.0625rem solid var(--black);
    font-size: 0.875rem;
    letter-spacing: 0.3125rem;
    text-transform: uppercase;
    color: var(--black);
  }

  .see-all:hover,
  .see-all:focus-visible {
    background: var(--black);
    color: var(--white);
  }

  .see-all[data-mobile] {
    display: none;
  }

  .grid {
    margin-block-start: 5rem;
    display: grid;
    grid-template-columns: repeat(4, 16rem);
    justify-content: space-between;
    row-gap: 1.8125rem;
  }

  .card {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 28.125rem;
    padding: 0 1.25rem 2rem 2.5rem;
    background-image: var(--img-desktop);
    background-size: cover;
    background-position: center;
    isolation: isolate;
    overflow: hidden;
  }

  /* dark gradient for legibility + white veil on hover */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, var(--shade-60), var(--shade-0) 65%);
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--veil);
    opacity: 0;
  }

  .card:hover::after,
  .card:focus-visible::after {
    opacity: 1;
  }

  .card:hover::before,
  .card:focus-visible::before {
    opacity: 0;
  }

  .card-title {
    position: relative;
    z-index: 2;
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: 2rem;
    line-height: 2rem;
    text-transform: uppercase;
    color: var(--white);
  }

  .card:hover .card-title,
  .card:focus-visible .card-title {
    color: var(--black);
  }

  @media (prefers-reduced-motion: no-preference) {
    .see-all {
      transition: background-color 0.25s ease, color 0.25s ease;
    }

    .card::before,
    .card::after {
      transition: opacity 0.3s ease;
    }

    .card-title {
      transition: color 0.3s ease;
    }
  }

  @media (max-width: 47.9375em) {
    .creations {
      margin-block-start: 6rem;
      margin-block-end: 5.9375rem;
      text-align: center;
    }

    .creations-head {
      justify-content: center;
    }

    h2 {
      font-size: 2rem;
      line-height: 2rem;
    }

    .see-all[data-desktop] {
      display: none;
    }

    .see-all[data-mobile] {
      display: inline-block;
      margin-block-start: 2.0625rem;
    }

    .creations-head,
    .grid {
      width: auto;
    }

    .grid {
      margin-block-start: 3rem;
      gap: 1.5rem;
      grid-template-columns: 1fr;
    }

    .card {
      height: 7.5rem;
      padding: 0 0 1.25rem 1.25rem;
      background-image: var(--img-mobile);
      text-align: left;
    }

    .card::before {
      background: linear-gradient(to right, var(--shade-60), var(--shade-0) 70%);
    }

    .card-title {
      font-size: 1.5rem;
      line-height: 1.5rem;
    }
  }
</style>
