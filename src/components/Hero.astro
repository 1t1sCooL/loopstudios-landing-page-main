---
import SiteHeader from './SiteHeader.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<section class="hero" style={`--hero-desktop: url(${base}images/desktop/image-hero.jpg); --hero-mobile: url(${base}images/mobile/image-hero.jpg)`}>
  <SiteHeader />
  <div class="container">
    <h1>Immersive experiences that<br class="m-br" /> deliver</h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 650px;
    background-image: var(--hero-desktop);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
  }

  /* the desktop mockup overlays the photo with 40% black; the mobile photo is pre-darkened */
  @media (min-width: 768px) {
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
    }
  }

  .m-br {
    display: none;
  }

  h1 {
    position: relative;
    width: 650px;
    max-width: 100%;
    margin-top: 80px;
    padding: 39px 40px 27px;
    border: 2px solid var(--white);
    color: var(--white);
    font-size: 72px;
    line-height: 70px;
  }

  @media (max-width: 767px) {
    .hero {
      background-image: var(--hero-mobile);
    }

    .m-br {
      display: inline;
    }

    h1 {
      margin-top: 0;
      padding: 25px 24px 17px;
      font-size: 40px;
      line-height: 38px;
    }
  }
</style>
