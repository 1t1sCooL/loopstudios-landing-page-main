---
import SiteHeader from './SiteHeader.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<section class="hero" style={`--hero-desktop: url(${base}images/desktop/image-hero.jpg); --hero-mobile: url(${base}images/mobile/image-hero.jpg)`}>
  <SiteHeader />
  <div class="container">
    <h1>Immersive experiences that<br class="m-br" /> deliver</h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 40.625rem;
    background-image: var(--hero-desktop);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
  }

  /* the desktop mockup overlays the photo with 40% black; the mobile photo is pre-darkened */
  @media (min-width: 48em) {
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--shade-40);
    }
  }

  .m-br {
    display: none;
  }

  h1 {
    position: relative;
    width: 40.625rem;
    max-width: 100%;
    margin-block-start: 5rem;
    padding: 2.4375rem 2.5rem 1.6875rem;
    border: 0.125rem solid var(--white);
    color: var(--white);
    font-size: 4.5rem;
    line-height: 4.375rem;
  }

  @media (max-width: 47.9375em) {
    .hero {
      background-image: var(--hero-mobile);
    }

    .m-br {
      display: inline;
    }

    h1 {
      margin-block-start: 0;
      padding: 1.5625rem 1.5rem 1.0625rem;
      font-size: 2.5rem;
      line-height: 2.375rem;
    }
  }
</style>
