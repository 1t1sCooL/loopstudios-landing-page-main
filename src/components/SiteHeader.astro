---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const links = ['About', 'Careers', 'Events', 'Products', 'Support'];
---

<header class="site-header">
  <div class="container header-inner">
    <a href={base} class="logo" aria-label="Loopstudios home">
      <img src={`${base}images/logo.svg`} alt="loopstudios" width="192" height="32" />
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {links.map((link) => (
          <li><a class="underline-link" href="#">{link}</a></li>
        ))}
      </ul>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      data-icon-open={`${base}images/icon-hamburger.svg`}
      data-icon-close={`${base}images/icon-close.svg`}
    >
      <img class="menu-icon" src={`${base}images/icon-hamburger.svg`} alt="" width="24" height="16" />
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <nav aria-label="Mobile">
      <ul class="container">
        {links.map((link) => (
          <li><a href="#">{link}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 10;
    padding-block-start: 4rem;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    position: relative;
    z-index: 30;
  }

  .logo img {
    width: 12rem;
    height: auto;
  }

  .desktop-nav ul {
    display: flex;
    gap: 2.0625rem;
  }

  .desktop-nav a {
    color: var(--white);
    font-size: 0.9375rem;
  }

  .menu-toggle {
    display: none;
    position: relative;
    z-index: 30;
    padding: 0.25rem;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 47.9375em) {
    .site-header {
      padding-block-start: 2.5rem;
    }

    .logo img {
      width: 9rem;
    }

    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: block;
    }

    .mobile-menu {
      display: flex;
      align-items: center;
      position: absolute;
      inset-block-start: 0;
      inset-inline: 0;
      block-size: 100vh;
      z-index: 20;
      background: var(--black);
      opacity: 0;
      visibility: hidden;
    }

    .mobile-menu nav {
      width: 100%;
    }

    body.menu-open .mobile-menu {
      opacity: 1;
      visibility: visible;
    }

    .mobile-menu ul {
      display: grid;
      gap: 1.5rem;
    }

    .mobile-menu a {
      font-family: var(--font-heading);
      font-weight: 300;
      font-size: 1.5rem;
      line-height: 1.5625rem;
      text-transform: uppercase;
      color: var(--white);
      display: inline-block;
      transform: translateX(0);
    }

    .mobile-menu a:hover,
    .mobile-menu a:focus-visible {
      transform: translateX(0.5rem);
      color: var(--grey-200);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu {
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .mobile-menu a {
      transition: transform 0.25s ease, color 0.25s ease;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const icon = toggle?.querySelector<HTMLImageElement>('.menu-icon');

  toggle?.addEventListener('click', () => {
    const open = document.body.classList.toggle('menu-open');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (icon) {
      icon.src = (open ? toggle.dataset.iconClose : toggle.dataset.iconOpen) ?? icon.src;
      icon.width = open ? 20 : 24;
      icon.height = open ? 20 : 16;
    }
  });
</script>
