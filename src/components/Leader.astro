---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<section class="leader container">
  <picture>
    <source media="(max-width: 767px)" srcset={`${base}images/mobile/image-interactive.jpg`} />
    <img
      src={`${base}images/desktop/image-interactive.jpg`}
      alt="Man wearing a VR headset, mouth open in excitement"
      width="731"
      height="500"
    />
  </picture>
  <div class="leader-copy">
    <h2>The leader in interactive&nbsp;VR</h2>
    <p>
      Founded in 2011, Loopstudios has been producing world-class virtual reality projects for
      some of the best companies around the globe. Our award-winning creations have transformed
      businesses through digital experiences that bind to their brand.
    </p>
  </div>
</section>

<style>
  .leader {
    position: relative;
    margin-block-start: 10rem;
  }

  .leader-copy {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 33.8125rem;
    padding: 6.125rem 0 0 6rem;
    background: var(--white);
  }

  h2 {
    font-size: 3rem;
    line-height: 3rem;
  }

  p {
    margin-block-start: 1.5625rem;
    max-width: 27.375rem; /* forces the same line breaks as the mockup */
    color: var(--grey-500);
  }

  @media (max-width: 47.9375em) {
    .leader {
      margin-block-start: 6rem;
    }

    picture img {
      width: 100%;
      height: auto;
    }

    .leader-copy {
      position: static;
      width: auto;
      padding: 3rem 0 0;
      text-align: center;
    }

    h2 {
      font-size: 2rem;
      line-height: 2rem;
      padding-inline: 1.5rem;
    }

    p {
      margin-block-start: 1rem;
      max-width: 18.5rem; /* mockup wraps the copy into 7 lines */
      margin-inline: auto;
    }
  }
</style>
